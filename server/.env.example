# Copy this file to server/.env and adjust the values.

PORT=5000

# Admin sign-in. When both are set they replace the login stored in data/nilavi_db.json.
# Change these before putting the site online.
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# Optional. Records are stored in data/nilavi_db.json; MongoDB is not used for storage yet.
# MONGODB_URI=mongodb://127.0.0.1:27017/nilavi
